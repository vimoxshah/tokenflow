# TokenFlow team server, environment file.
#
# Docker:  cp deploy/team.env.example deploy/team.env
# systemd: sudo cp deploy/team.env.example /etc/tokenflow/team.env
#          sudo chmod 600 /etc/tokenflow/team.env
#
# See docs/team-server.md for the full guide.

# Required, even though a loopback bind (the default, and the systemd
# unit's own --host 127.0.0.1) does not force one at startup. Put this
# server behind deploy/Caddyfile or deploy/nginx.conf and skip this, and
# every route those proxies forward is open to anyone who can reach them:
# the bind-address check only protects a server that binds a public
# address directly, not one reached through a reverse proxy. Generate one
# shared secret and give it to every laptop as sync.token (or
# TOKENFLOW_SYNC_TOKEN):
#
#   openssl rand -hex 32
TOKENFLOW_TEAM_TOKEN=

# Where the server stores its data: uploaded rollups, the receipts ledger,
# and policy.yaml if the org declares one.
#   Docker:   fixed at /data by docker-compose.yml; this value is ignored
#             there (see the comment on that file's TOKENFLOW_HOME line) and
#             only takes effect for the systemd deployment.
#   systemd:  must match the unit's ReadWritePaths entry exactly.
TOKENFLOW_HOME=/var/lib/tokenflow

# Optional: the self-hosted GitHub App receiver (POST /github/webhook).
# Leave all three blank to keep that route disabled (answers 404). See
# docs/github-app.md for how to register the App and get these values.
TOKENFLOW_GH_APP_ID=
TOKENFLOW_GH_PRIVATE_KEY_FILE=
TOKENFLOW_GH_WEBHOOK_SECRET=

# Optional: only needed for a GitHub Enterprise Server install. Default is
# https://api.github.com.
TOKENFLOW_GH_API_URL=
